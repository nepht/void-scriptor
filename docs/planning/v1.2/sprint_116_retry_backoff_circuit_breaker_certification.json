  "area_rules": {
    "idempotency": "every retried write carries a stable idempotency key; an operation declared idempotent must repeat the same key on every attempt above index 0",
    "bounded_retry": "max_attempts is between 1 and 10, base_delay_ms is positive, max_delay_ms is never below base_delay_ms, and recorded attempts never exceed the ceiling",
    "exponential_backoff": "the recorded theoretical delay equals the policy schedule (base * 2^(attempt-1) clamped to the ceiling) and the actual delay stays within the declared jitter ratio",
    "jitter": "at least one backoff attempt deviates from the theoretical delay by a non-zero amount inside the declared ratio, so clients do not retry in lockstep",
    "retry_after": "a rate-limited attempt must name the provider retry_after source, carry a positive provider_retry_after_seconds, and actually wait at least that long",
    "cancellation": "cancellation is supported and no attempt is recorded above the cancellation index; a loop that continues after cancellation fails closed",
    "circuit_breaker": "a breaker record exists with a known state, a positive failure threshold and open duration, a closed circuit stays below its threshold, and an open circuit records no further attempts"
  },
  "external_gates": "DEFERRED-EXTERNAL",
