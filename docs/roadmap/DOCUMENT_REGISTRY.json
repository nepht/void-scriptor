{
  "schema_version": 1,
  "product": "Void Scriptor",
  "purpose": "Authority allowlist for roadmap-relevant documents without a sprint number.",
  "defaults": {
    "unregistered_authority": "NON_BINDING",
    "may_create_scope": false,
    "may_mark_implementation_complete": false,
    "may_change_runtime_pointer": false
  },
  "strict_authority_roots": [
    "docs/roadmap"
  ],
  "discovery_exclusions": [
    "docs/roadmap/DOCUMENT_REGISTRY.json"
  ],
  "role_rules": {
    "POLICY": "May choose or suspend an already-defined sprint stream; cannot invent feature scope.",
    "EXECUTOR_POLICY": "May constrain Hermes execution; cannot invent feature scope or acceptance criteria.",
    "GOVERNANCE_GUIDE": "Human-readable explanation only.",
    "EXECUTION_SUMMARY": "Derived status summary; never an execution pointer.",
    "HISTORICAL_LEDGER": "Historical evidence summary; never an execution pointer.",
    "EVIDENCE": "May support a status classification but cannot prove completion by itself.",
    "REFERENCE": "Context only and non-binding.",
    "BACKLOG": "Candidate work only; requires a canonical sprint contract before execution.",
    "GENERATED": "Tool output only and non-binding."
  },
